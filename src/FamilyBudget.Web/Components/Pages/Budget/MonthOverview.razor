@page "/grupp/{GroupId:int}"
@page "/grupp/{GroupId:int}/manad/{Year:int}/{Month:int}"
@rendermode InteractiveServer
@inject BudgetGroupAccess GroupAccess
@inject IDbContextFactory<FamilyBudgetDbContext> ContextFactory

<PageTitle>@(budgetGroup?.Name ?? "Budget")</PageTitle>

@if (isLoading)
{
    <p>Laddar…</p>
}
else if (budgetGroup is null)
{
    <NoAccess />
}
else
{
    <BudgetGroupTabs GroupId="GroupId" GroupName="@budgetGroup.Name" ActiveTab="manad" />

    @* Month navigation *@
    <div class="d-flex flex-wrap align-items-center gap-2 gap-sm-3 mb-3">
        <a class="btn btn-outline-secondary btn-sm" href="@MonthLink(-1)" aria-label="Föregående månad">‹<span class="d-none d-sm-inline"> Föregående</span></a>
        <h2 class="h4 mb-0">@BudgetTexts.MonthTitle(shownYear, shownMonth)</h2>
        <a class="btn btn-outline-secondary btn-sm" href="@MonthLink(1)" aria-label="Nästa månad"><span class="d-none d-sm-inline">Nästa </span>›</a>
        @* Generate this month's bills and incomes from templates and last month in one go. *@
        <a class="btn btn-outline-primary btn-sm ms-auto" href="@($"grupp/{GroupId}/skapa-manad/{shownYear}/{shownMonth}")">Skapa poster för månaden…</a>
    </div>

    @* Summary of the month *@
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card"><div class="card-body">
                <div class="text-muted small">Inkomster</div>
                <div class="fs-5">@BudgetTexts.Money(expectedIncome)</div>
                <div class="small text-muted">Mottaget: @BudgetTexts.Money(receivedIncome)</div>
            </div></div>
        </div>
        <div class="col-sm-4">
            <div class="card"><div class="card-body">
                <div class="text-muted small">Utgifter</div>
                <div class="fs-5">@BudgetTexts.Money(expectedExpenses)</div>
                <div class="small text-muted">Kvar att betala: @BudgetTexts.Money(expensesLeftToPay)</div>
            </div></div>
        </div>
        <div class="col-sm-4">
            <div class="card"><div class="card-body">
                <div class="text-muted small">Över efter fakturor</div>
                <div class="fs-5 @(expectedIncome - expectedExpenses < 0 ? "text-danger" : "text-success")">
                    @BudgetTexts.Money(expectedIncome - expectedExpenses)
                </div>
            </div></div>
        </div>
    </div>

    @if (dueRows.Count == 0)
    {
        <p class="text-muted">Inget förfaller den här månaden. Lägg till fakturor och inkomster under fliken <a href="@($"grupp/{GroupId}/poster")">Fakturor och inkomster</a>.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-cards table align-middle">
                <thead>
                    <tr>
                        <th>Förfaller</th>
                        <th>Namn</th>
                        <th>Kategori</th>
                        <th class="text-end">Belopp</th>
                        <th>Betalt belopp</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dueRow in dueRows)
                    {
                        <tr class="@RowCssClass(dueRow)">
                            <td data-label="Förfaller">@BudgetTexts.Date(dueRow.DueDate)</td>
                            <td data-card-title>
                                <a href="@($"grupp/{GroupId}/poster/{dueRow.Entry.Id}")">@dueRow.Entry.Name</a>
                                <span class="badge @(dueRow.Entry.Kind == EntryKind.Income ? "text-bg-success" : "text-bg-secondary") ms-1">
                                    @BudgetTexts.Kind(dueRow.Entry.Kind)
                                </span>
                            </td>
                            <td data-label="Kategori">@dueRow.Entry.Category?.Name</td>
                            <td data-label="Belopp" class="text-end">@BudgetTexts.Money(dueRow.Entry.Amount)</td>
                            <td data-label="Betalt belopp" style="max-width: 10rem">
                                @if (dueRow.Payment is null)
                                {
                                    @* The actual amount can be adjusted before marking as paid, e.g. a varying salary. *@
                                    <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                           @bind="dueRow.AmountToRegister" aria-label="Betalt belopp" />
                                }
                                else
                                {
                                    @BudgetTexts.Money(dueRow.Payment.Amount)
                                }
                            </td>
                            <td class="text-nowrap">
                                @if (dueRow.Payment is null)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => MarkAsPaidAsync(dueRow)">
                                        @(dueRow.Entry.Kind == EntryKind.Income ? "Mottagen" : "Betald")
                                    </button>
                                }
                                else
                                {
                                    <span class="text-success me-2">✓ @(dueRow.Entry.Kind == EntryKind.Income ? "Mottagen" : "Betald")</span>
                                    <button class="btn btn-sm btn-link" @onclick="() => UndoPaymentAsync(dueRow)">Ångra</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private bool isLoading = true;
    private BudgetGroup? budgetGroup;
    private List<DueRow> dueRows = [];
    private int shownYear;
    private int shownMonth;

    // Totals for the summary cards.
    private decimal expectedIncome;
    private decimal receivedIncome;
    private decimal expectedExpenses;
    private decimal expensesLeftToPay;

    [Parameter] public int GroupId { get; set; }
    [Parameter] public int? Year { get; set; }
    [Parameter] public int? Month { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        // Without year/month in the address, show the current month.
        var today = DateOnly.FromDateTime(DateTime.Today);
        shownYear = Year ?? today.Year;
        shownMonth = Month is >= 1 and <= 12 ? Month.Value : today.Month;

        var authenticationState = await AuthenticationStateTask;
        budgetGroup = await GroupAccess.GetGroupForMemberAsync(authenticationState.User, GroupId);
        if (budgetGroup is not null)
        {
            await LoadMonthAsync();
        }
        isLoading = false;
    }

    private async Task LoadMonthAsync()
    {
        var firstDayOfMonth = new DateOnly(shownYear, shownMonth, 1);
        var lastDayOfMonth = firstDayOfMonth.AddMonths(1).AddDays(-1);

        await using var databaseContext = await ContextFactory.CreateDbContextAsync();

        // Only entries that can fall due this month: started before the month ends, not ended before it starts.
        var entries = await databaseContext.BudgetEntries
            .Where(entry => entry.BudgetGroupId == GroupId
                && entry.FirstDueDate <= lastDayOfMonth
                && (entry.EndDate == null || entry.EndDate >= firstDayOfMonth))
            .Include(entry => entry.Category)
            .Include(entry => entry.Payments.Where(payment => payment.DueDate >= firstDayOfMonth && payment.DueDate <= lastDayOfMonth))
            .AsNoTracking()
            .ToListAsync();

        dueRows = entries
            .SelectMany(entry => DueDateCalculator.GetDueDates(entry, firstDayOfMonth, lastDayOfMonth)
                .Select(dueDate => new DueRow(entry, dueDate, entry.Payments.FirstOrDefault(payment => payment.DueDate == dueDate))))
            .OrderBy(dueRow => dueRow.DueDate)
            .ThenBy(dueRow => dueRow.Entry.Kind)
            .ThenBy(dueRow => dueRow.Entry.Name)
            .ToList();

        CalculateTotals();
    }

    private void CalculateTotals()
    {
        var incomeRows = dueRows.Where(dueRow => dueRow.Entry.Kind == EntryKind.Income).ToList();
        var expenseRows = dueRows.Where(dueRow => dueRow.Entry.Kind == EntryKind.Expense).ToList();

        expectedIncome = incomeRows.Sum(dueRow => dueRow.Entry.Amount);
        receivedIncome = incomeRows.Where(dueRow => dueRow.Payment is not null).Sum(dueRow => dueRow.Payment!.Amount);
        expectedExpenses = expenseRows.Sum(dueRow => dueRow.Entry.Amount);
        expensesLeftToPay = expenseRows.Where(dueRow => dueRow.Payment is null).Sum(dueRow => dueRow.Entry.Amount);
    }

    private async Task MarkAsPaidAsync(DueRow dueRow)
    {
        await using var databaseContext = await ContextFactory.CreateDbContextAsync();

        // Guard against double clicks: only add if this due date is not already registered.
        var existingPayment = await databaseContext.EntryPayments
            .FirstOrDefaultAsync(payment => payment.BudgetEntryId == dueRow.Entry.Id && payment.DueDate == dueRow.DueDate);

        if (existingPayment is null)
        {
            existingPayment = new EntryPayment
            {
                BudgetEntryId = dueRow.Entry.Id,
                DueDate = dueRow.DueDate,
                Amount = dueRow.AmountToRegister,
            };
            databaseContext.EntryPayments.Add(existingPayment);
            await databaseContext.SaveChangesAsync();
        }

        dueRow.Payment = existingPayment;
        CalculateTotals();
    }

    private async Task UndoPaymentAsync(DueRow dueRow)
    {
        await using var databaseContext = await ContextFactory.CreateDbContextAsync();
        await databaseContext.EntryPayments
            .Where(payment => payment.BudgetEntryId == dueRow.Entry.Id && payment.DueDate == dueRow.DueDate)
            .ExecuteDeleteAsync();

        dueRow.Payment = null;
        dueRow.AmountToRegister = dueRow.Entry.Amount;
        CalculateTotals();
    }

    /// <summary>Link to the month <paramref name="monthOffset"/> months from the one shown.</summary>
    private string MonthLink(int monthOffset)
    {
        var targetMonth = new DateOnly(shownYear, shownMonth, 1).AddMonths(monthOffset);
        return $"grupp/{GroupId}/manad/{targetMonth.Year}/{targetMonth.Month}";
    }

    /// <summary>Paid rows are greyed out; unpaid bills that are overdue are highlighted.</summary>
    private static string RowCssClass(DueRow dueRow)
    {
        if (dueRow.Payment is not null)
        {
            return "text-muted";
        }
        var isOverdue = dueRow.DueDate < DateOnly.FromDateTime(DateTime.Today);
        return isOverdue && dueRow.Entry.Kind == EntryKind.Expense ? "table-warning" : string.Empty;
    }

    /// <summary>One due date of one entry, as shown in the table.</summary>
    private sealed class DueRow(BudgetEntry entry, DateOnly dueDate, EntryPayment? payment)
    {
        public BudgetEntry Entry { get; } = entry;
        public DateOnly DueDate { get; } = dueDate;
        public EntryPayment? Payment { get; set; } = payment;

        /// <summary>Amount to register when marking as paid; starts as the expected amount.</summary>
        public decimal AmountToRegister { get; set; } = entry.Amount;
    }
}
