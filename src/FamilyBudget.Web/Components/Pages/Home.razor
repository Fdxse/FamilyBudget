@page "/"
@inject IDbContextFactory<FamilyBudgetDbContext> ContextFactory
@inject UserManager<ApplicationUser> UserManager

<PageTitle>FamilyBudget</PageTitle>

<h1>Hej @displayName!</h1>

<h2 class="h5 mt-4">Dina budgetgrupper</h2>
@if (memberBudgetGroups.Count == 0)
{
    <p class="text-muted">Du är inte med i någon budgetgrupp ännu. Be den som administrerar FamilyBudget att lägga till dig.</p>
}
else
{
    <ul>
        @foreach (var memberBudgetGroup in memberBudgetGroups)
        {
            <li><a href="@($"grupp/{memberBudgetGroup.Id}")">@memberBudgetGroup.Name</a></li>
        }
    </ul>
}

@* Simple status line so you can see at a glance that the NAS setup works end to end. *@
<p class="text-muted small mt-5">
    Databas: @(isDatabaseReachable ? "ansluten" : "ej nåbar") · Version: @applicationVersion
</p>

@code {
    private string displayName = string.Empty;
    private List<(int Id, string Name)> memberBudgetGroups = [];
    private bool isDatabaseReachable;
    private string applicationVersion = "okänd";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await using var databaseContext = await ContextFactory.CreateDbContextAsync();
        isDatabaseReachable = await databaseContext.Database.CanConnectAsync();

        // Look up the logged-in user's name and budget groups.
        var currentUserId = UserManager.GetUserId(HttpContext.User);
        var currentUser = await databaseContext.Users
            .Include(user => user.BudgetGroupMemberships)
            .ThenInclude(membership => membership.BudgetGroup)
            .FirstOrDefaultAsync(user => user.Id == currentUserId);

        displayName = currentUser?.DisplayName ?? string.Empty;
        memberBudgetGroups = currentUser?.BudgetGroupMemberships
            .Select(membership => (membership.BudgetGroup.Id, membership.BudgetGroup.Name))
            .OrderBy(budgetGroup => budgetGroup.Name)
            .ToList() ?? [];

        // The Git commit is passed into the image at build time (see Dockerfile / update script).
        applicationVersion = Environment.GetEnvironmentVariable("APP_GIT_COMMIT") ?? "lokal utveckling";
    }
}
