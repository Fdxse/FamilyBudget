@page "/konto/byt-losenord"
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

<PageTitle>Byt lösenord</PageTitle>

<h1>Byt lösenord</h1>

<div class="row">
    <div class="col-md-5">
        <StatusMessage Message="@statusMessage" IsError="@isError" />

        <EditForm Model="Input" method="post" OnValidSubmit="ChangePasswordAsync" FormName="change-password">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="currentPassword" class="form-label">Nuvarande lösenord</label>
                <InputText id="currentPassword" type="password" @bind-Value="Input.CurrentPassword" class="form-control" autocomplete="current-password" />
                <ValidationMessage For="() => Input.CurrentPassword" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="newPassword" class="form-label">Nytt lösenord (minst 8 tecken)</label>
                <InputText id="newPassword" type="password" @bind-Value="Input.NewPassword" class="form-control" autocomplete="new-password" />
                <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="confirmPassword" class="form-label">Upprepa nytt lösenord</label>
                <InputText id="confirmPassword" type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary">Spara</button>
        </EditForm>
    </div>
</div>

@code {
    private string? statusMessage;
    private bool isError;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangePasswordInput Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new ChangePasswordInput();

    private async Task ChangePasswordAsync()
    {
        var currentUser = await UserManager.GetUserAsync(HttpContext.User);
        if (currentUser is null)
        {
            statusMessage = "Kunde inte hitta ditt konto.";
            isError = true;
            return;
        }

        var changeResult = await UserManager.ChangePasswordAsync(currentUser, Input.CurrentPassword, Input.NewPassword);
        if (!changeResult.Succeeded)
        {
            statusMessage = string.Join(" ", changeResult.Errors.Select(error => error.Description));
            isError = true;
            return;
        }

        // Renew the login cookie so the user stays logged in with the new security stamp.
        await SignInManager.RefreshSignInAsync(currentUser);
        statusMessage = "Lösenordet är bytt.";
        isError = false;
        Input = new ChangePasswordInput();
    }

    private sealed class ChangePasswordInput
    {
        [Required(ErrorMessage = "Ange nuvarande lösenord.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ange ett nytt lösenord.")]
        public string NewPassword { get; set; } = string.Empty;

        [Compare(nameof(NewPassword), ErrorMessage = "Lösenorden matchar inte.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
