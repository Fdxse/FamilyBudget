@* Tabs shown at the top of every budget page for one group. *@
<h1>@GroupName</h1>
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(ActiveTab == "manad" ? "active" : "")" href="@($"grupp/{GroupId}")">Månad</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ActiveTab == "poster" ? "active" : "")" href="@($"grupp/{GroupId}/poster")">Fakturor och inkomster</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ActiveTab == "mallar" ? "active" : "")" href="@($"grupp/{GroupId}/mallar")">Mallar</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ActiveTab == "kategorier" ? "active" : "")" href="@($"grupp/{GroupId}/kategorier")">Kategorier</a>
    </li>
</ul>

@code {
    [Parameter, EditorRequired] public int GroupId { get; set; }
    [Parameter, EditorRequired] public string GroupName { get; set; } = string.Empty;

    /// <summary>Which tab is highlighted: manad, poster, mallar or kategorier.</summary>
    [Parameter, EditorRequired] public string ActiveTab { get; set; } = string.Empty;
}
