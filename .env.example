# Copy this file to .env on the NAS and fill in real values.
# .env is ignored by Git, so passwords never end up on GitHub.

# Shared folder on the NAS where database files and keys are stored.
DATA_ROOT=/volume1/familybudget

# Port on the NAS where the web app answers (http://<nas>:5080).
APP_PORT=5080

# Passwords for MariaDB. Pick long random values.
DATABASE_PASSWORD=change-me
DATABASE_ROOT_PASSWORD=change-me-too

# Time zone for the containers.
TIMEZONE=Europe/Stockholm

# Branch the update script deploys from.
DEPLOY_BRANCH=main
